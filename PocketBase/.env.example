# IGDB API credentials (https://api-docs.igdb.com/#account-creation)
CLIENT_ID=your_igdb_client_id
CLIENT_SECRET=your_igdb_client_secret

# Production (docker-compose.prod.yml) - required for serve with autocert:
PB_HOST=your-api-domain.example.com
PB_ORIGINS=https://your-frontend-origin.example.com
