# Copy this file to set up your environment. Vite loads env files by mode:
#
#   npm run dev    -> .env.local            (gitignored, your machine only)
#   npm run build  -> .env.production       (gitignored, production API)
#
# .env.local is loaded in every mode but has lower priority than
# .env.production, so a production build always uses the production API.
# A plain .env file is NOT used here: .env.local would override it in
# production builds too.
#
# Every value below is commented out on purpose. Uncomment the one you need
# after copying, so a forgotten edit fails the build instead of silently
# shipping the wrong API.

# Backend API base URL, baked into the bundle at build time.

# Local dev (.env.local):
# VITE_PB_API="http://127.0.0.1:8090"

# Production (.env.production):
# VITE_PB_API="https://api.example.com"
